#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-2-Clause

set -e

source $DOCKER_BUILD_DIR/.ci/docker-prelude.sh

# export ptool location
export PATH=$PATH:"$DOCKER_BUILD_DIR"/tools

# Do not run tests when building on coverity_scan branch
if [ "${COVERITY_SCAN_BRANCH}" == 1 ]; then
  echo "Coverity scan branch detected, not running build nor tests...exiting!"
  exit 0
fi

if [ "$ENABLE_FUZZING" == "true" ]; then
  echo "Enabling fuzz build"
  ./bootstrap
  ./configure --enable-fuzzing --enable-debug
  make -j4 check
  exit 0
fi

# If it's clang, enable asan unless we are on musl. The ASan runtime is
# unstable on musl when non-ASan executables (pkcs11-tool, p11tool, openssl,
# ssh-keygen, ...) dlopen the ASan-instrumented libtpm2_pkcs11.so, so build
# the musl clang lane without sanitizer instrumentation. Other clang lanes
# (glibc-based) keep ASan coverage.
if [[ "$CC" == clang* ]]; then
  if ldd --version 2>&1 | grep -qi musl; then
    echo "Detecting clang on musl; ASan disabled for this lane"
  else
    echo "Detecting clang, enable asan"
    config_flags="--enable-asan"
    export ASAN_ENABLED=true
    echo "Exported ASAN_ENABLED=$ASAN_ENABLED"
  fi
  # To get line numbers set up the asan symbolizer
  clang_version=`$CC --version | head -n 1 | cut -d\  -f 3-3 | cut -d\. -f 1-2`
  # Sometimes the version string has an Ubuntu on the front of it and the field
  # location changes
  if [ $clang_version == "version" ]; then
    clang_version=`$CC --version | head -n 1 | cut -d\  -f 4-4 | cut -d\. -f 1-2`
  fi
  echo "Detected clang version: $clang_version"
  # Prefer the symbolizer shipped with the selected compiler. This works across
  # distro layouts (Debian /usr/lib/llvm-N, Alpine /usr/lib/llvmN, openSUSE
  # /usr/bin) and avoids hardcoding versioned paths that drift with every clang
  # release.
  ASAN_SYMBOLIZER_PATH=`$CC -print-prog-name=llvm-symbolizer`
  if [ ! -e "$ASAN_SYMBOLIZER_PATH" ]; then
    ASAN_SYMBOLIZER_PATH=$(command -v llvm-symbolizer 2>/dev/null || true)
  fi
  if [ -n "$ASAN_SYMBOLIZER_PATH" ] && [ -e "$ASAN_SYMBOLIZER_PATH" ]; then
    export ASAN_SYMBOLIZER_PATH
    echo "Exported ASAN_SYMBOLIZER_PATH=$ASAN_SYMBOLIZER_PATH"
  else
    echo "No llvm symbolizer found at: $ASAN_SYMBOLIZER_PATH"
    unset ASAN_SYMBOLIZER_PATH
  fi
  # clang, you fickle beast, under version 9 I know you don't like building in the CRT
  # for things like __builtin_mul (undefined references to __muloti4)
  major_ver=$(echo $clang_version | cut -d'.' -f 1-1)
  if [ "$major_ver" -lt 9 ]; then
    echo "Detecting clang less than version 9, enabling --enable-debug --disable-overflow"
    config_flags="$config_flags --enable-debug --disable-overflow"
    echo "config_flags: $config_flags"
  fi
else
  echo "Enabling Code Coverage"
  config_flags="--disable-hardening --enable-code-coverage"
  # Ubuntu 26.04 ships a newer cmocka that deprecates assert_in_range; keep CI unblocked.
  if [[ "$DOCKER_IMAGE" == ubuntu-26.04* ]]; then
    export CFLAGS="${CFLAGS:+$CFLAGS }-Wno-error=deprecated-declarations"
  fi
fi

# Bootstrap the project
# Some local reruns mount a previously configured worktree.
# Ensure we start from a clean source tree before out-of-tree configure.
if [ -f ./config.status ]; then
  make distclean || true
fi

# Mounted trees can retain stale libtool macros generated by a different
# libtool release than the container provides. Drop aclocal.m4 so the next
# autoreconf --install copies a matching set for this distro.
rm -f aclocal.m4

./bootstrap

# clang and gcc can have features enabled in the config_flags that
# avoid error checking or cause make distcheck to fail. So run a
# pure check with gcc before adding those flags.
if [[ "$CC" != clang* ]]; then
    ./configure --enable-esapi-session-manage-flags --disable-fapi --enable-unit --enable-integration
    make distcheck TESTS=
    make distclean
fi

# Make a unique build variant directory per run so parallel CI lanes that
# share a source-tree mount do not delete each other's working directory.
rm -rf ./build.*
build_dir=$(mktemp -d ./build.XXXXXX)
echo "Using build directory: $build_dir"
pushd "$build_dir"

# Run scan-build for gcc only.
# Scan-build does not work with clang because of asan linking errors.
if [[ "$CC" != clang* ]]; then
    scan-build ../configure --enable-unit --enable-integration --enable-debug=yes $config_flags
    scan-build --status-bugs make -j$(nproc)

    # scan-build causes test_tpm2_session to fail, so
    # rebuild after running scan-build.
fi

# FAPI backend initialization segfaults on musl when non-FAPI executables load
# libtpm2_pkcs11.so (observed with pkcs11-tool / p11tool). Disable FAPI for the
# clang/musl lane; other lanes keep FAPI coverage.
if ldd --version 2>&1 | grep -qi musl; then
  ../configure --enable-unit --enable-integration --enable-esapi-session-manage-flags --with-fapi=no $config_flags
else
  ../configure --enable-unit --enable-integration --enable-esapi-session-manage-flags --with-fapi=yes $config_flags
fi
make -j$(nproc)
if ! make -j check; then
  echo "=== test-suite.log ==="
  cat test-suite.log || true
  cp test-suite.log "$DOCKER_BUILD_DIR/test-suite.log.$DOCKER_IMAGE" || true
  echo "=== end test-suite.log ==="
  exit 1
fi

if [[ "$ENABLE_COVERAGE" == "true" ]]; then
    bash <(curl -s https://codecov.io/bash)
fi

popd

exit 0
